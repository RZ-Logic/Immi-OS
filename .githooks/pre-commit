#!/bin/sh
# Immi-OS pre-commit: secret scan on staged file contents (git show :path).
# Blocks the commit on any finding. Prints pattern type and location only.
# Enabled with: git config core.hooksPath .githooks

root=$(git rev-parse --show-toplevel) || exit 1

py=""
for cand in python python3 py; do
    if command -v "$cand" >/dev/null 2>&1 && "$cand" -c "import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)" >/dev/null 2>&1; then
        py=$cand
        break
    fi
done
if [ -z "$py" ]; then
    echo "pre-commit: no Python 3.9+ found, secret scan cannot run. Commit blocked." >&2
    exit 1
fi

"$py" "$root/scripts/secret_scan.py" --staged
status=$?
if [ "$status" -ne 0 ]; then
    echo "pre-commit: commit blocked by secret scan (exit $status). Remove the literal, use a Make connection or .env, then restage." >&2
    exit 1
fi

# X-36.1: a registered prompt version never changes or disappears. Only when ref/prompts.json is staged, so the hook
# needs nothing else in a repository that has no registry.
if [ -n "$(git diff --cached --name-only -- ref/prompts.json)" ]; then
    "$py" "$root/scripts/prompt_registry.py" check --staged
    status=$?
    if [ "$status" -ne 0 ]; then
        echo "pre-commit: commit blocked, a registered prompt version changed or is gone (exit $status). Restore it and register the edit as a new version." >&2
        exit 1
    fi
fi
exit 0

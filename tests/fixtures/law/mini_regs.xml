<?xml version="1.0"?><Regulation lims:pit-date="2026-07-15" lims:lastAmendedDate="2026-07-15" lims:current-date="2026-07-21" lims:fid="100" lims:id="100" regulation-type="SOR" xml:lang="en" xmlns:lims="http://justice.gc.ca/lims"><Identification><InstrumentNumber>SOR/2002-227</InstrumentNumber><ShortTitle status="official">Synthetic Regulations</ShortTitle></Identification><Body>
<Heading level="1"><TitleText>PART 12 Students</TitleText></Heading>
<Heading level="2"><TitleText>DIVISION 3 Issuance of Study Permits</TitleText></Heading>
<Section lims:inforce-start-date="2014-06-01" lims:lastAmendedDate="2024-11-08" lims:fid="200" lims:id="200"><MarginalNote>Study permits</MarginalNote><Label>216</Label><Subsection lims:fid="201" lims:id="201"><Label>(1)</Label><Text>An officer shall issue a study permit if the foreign national's</Text><Paragraph lims:fid="202" lims:id="202"><Label>(a)</Label><Text>application is complete;</Text></Paragraph><Paragraph lims:fid="203" lims:id="203"><Label>(b)</Label><Text>stay is temporary.</Text></Paragraph><Paragraph lims:fid="204" lims:id="204"><Label>(c) to (e)</Label><Text><Repealed>[Repealed, SOR/2012-274, s. 13]</Repealed></Text></Paragraph></Subsection><Subsection lims:fid="205" lims:id="205"><Label>(2) and (3)</Label><Text><Repealed>[Repealed, SOR/2008-253, s. 9]</Repealed></Text></Subsection><Subsection lims:fid="206" lims:id="206"><Label>(4)</Label><Text>A permit is valid if</Text><Paragraph lims:fid="207" lims:id="207"><Label>a)</Label><Text>the fee is paid.</Text></Paragraph></Subsection></Section>
<Section lims:fid="210" lims:id="210"><MarginalNote>Exception</MarginalNote><Label>216.1</Label><Text>Section 216 does not apply to a minor child.</Text></Section>
</Body></Regulation>
